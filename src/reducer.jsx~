export const initialState = {
    field: ["", "", "", "", "", "", "", "", ""], // Пустой массив для начала
    currentPlayer: "X",
}

export const appReducer = (state = initialState, action) => {

    const {type, payload} = action

    switch (type) {
        case "SET_CURRENT_PLAYER":
            return {
                ...state,
                currentPlayer: payload
            }
        case "SET_FIELD":
            return {
                ...state,
                field: payload
            }
        case "RESTART_GAME":
            return initialState
        case "SET_IS_GAME_ENDED":
            return {
                ...state,
                isGameEnded: payload
            }
        case "SET_IS_DRAW":
            return {
                ...state,
                isDraw: payload
            }
        default:
            return state
    }
}
